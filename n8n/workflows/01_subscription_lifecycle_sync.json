{
  "name": "01 - SyncCore Subscription Lifecycle Sync",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "Use this workflow for customer.subscription.updated and customer.subscription.deleted demo events. It posts the payload to the dashboard first, then shows where mock CRM sync and optional persistence work would happen.",
        "height": 220,
        "width": 360,
        "color": 5
      },
      "id": "sticky-lifecycle-overview",
      "name": "Lifecycle Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -760,
        -120
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -720,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = {\n  id: 'evt_demo_subscription_updated_001',\n  type: 'customer.subscription.updated',\n  livemode: false,\n  created: 1780502400,\n  data: {\n    object: {\n      id: 'sub_demo_scale_001',\n      customer: 'cus_norte_cloud',\n      currency: 'usd',\n      status: 'active',\n      metadata: {\n        account_domain: 'norte.cloud',\n        crm_company_id: 'crm_norte_cloud',\n        usage_density: '56'\n      },\n      items: {\n        data: [\n          {\n            price: {\n              unit_amount: 35000\n            }\n          }\n        ]\n      }\n    }\n  }\n};\n\nreturn [{ json: payload }];"
      },
      "id": "load-subscription-payload",
      "name": "Load Subscription Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SYNC_CORE_INGEST_URL || 'http://host.docker.internal:3000/api/events/ingest'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {}
      },
      "id": "post-subscription-event",
      "name": "POST Subscription Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        160
      ],
      "notes": "The dashboard route stays the source-of-truth for validation, normalization, and event_log writes.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$json.normalizedEvent.type}}",
              "rightValue": "customer.subscription.",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-subscription-response",
      "name": "Is Subscription Response?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        80,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const normalized = $json.normalizedEvent;\nconst summary = {\n  providerEventId: normalized.providerEventId,\n  accountDomain: normalized.accountDomain,\n  eventType: normalized.type,\n  amount: normalized.amount,\n  status: normalized.status,\n  message: 'Lifecycle sync would refresh account and subscription state, then hand off a mock CRM sync summary.'\n};\nreturn [{ json: summary }];"
      },
      "id": "build-lifecycle-summary",
      "name": "Build Lifecycle Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        60
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$env.DEMO_MODE || 'true'}}",
              "rightValue": "false",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-persistence-mode",
      "name": "Is Persistence Mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        620,
        60
      ],
      "notes": "Only use the optional Postgres steps when you intentionally run the dashboard with DEMO_MODE=false and valid Supabase or local database credentials.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select 'placeholder' as note;"
      },
      "id": "upsert-account-and-subscription",
      "name": "Upsert Account And Subscription (Optional)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        900,
        -40
      ],
      "notes": "Template node only. Replace the placeholder query after you decide how much of the lifecycle write path should live in n8n instead of the app.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    channel: 'mock-crm',\n    status: 'simulated',\n    message: 'In demo mode, stop here and inspect the lifecycle summary rather than calling a real CRM API.'\n  }\n}];"
      },
      "id": "demo-mode-summary",
      "name": "Demo Mode Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    message: 'This branch catches unexpected responses from the dashboard ingest route. Check the HTTP Request node result before activating the workflow.'\n  }\n}];"
      },
      "id": "unexpected-response-note",
      "name": "Unexpected Response Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    }
  ],
  "connections": {
