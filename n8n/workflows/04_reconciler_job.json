{
  "name": "04 - SyncCore Reconciler Job",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "Reconciler v1. This workflow is still mock-first because there is no real CRM adapter yet. Use Manual Trigger for demo review, or schedule it later once local database credentials are configured in n8n.",
        "height": 220,
        "width": 380,
        "color": 5
      },
      "id": "sticky-reconciler-overview",
      "name": "Reconciler Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -820,
        -140
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "scheduled-reconciliation-trigger",
      "name": "Scheduled Reconciliation Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -780,
        320
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -780,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select a.id, a.name, a.normalized_domain, a.lifecycle_stage, a.mrr, s.status as subscription_status, s.tier from accounts a left join subscriptions s on s.account_id = a.id order by a.name;"
      },
      "id": "load-billing-snapshot",
      "name": "Load Billing Snapshot (Optional)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -500,
        320
      ],
      "notes": "Optional query template for local Postgres or another writable operational store. Leave inactive until credentials are set.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      accountId: '11111111-1111-4111-8111-111111111111',\n      accountName: 'Acme AI Labs',\n      billingStatus: 'active',\n      crmStatus: 'cancelled',\n      billingMrr: 1200,\n      crmMrr: 1200,\n      billingTier: 'growth',\n      crmTier: 'growth'\n    }\n  },\n  {\n    json: {\n      accountId: '22222222-2222-4222-8222-222222222222',\n      accountName: 'Norte Cloud',\n      billingStatus: 'active',\n      crmStatus: 'active',\n      billingMrr: 350,\n      crmMrr: 250,\n      billingTier: 'starter',\n      crmTier: 'starter'\n    }\n  }\n];"
      },
      "id": "load-mock-crm-snapshot",
      "name": "Load Mock CRM Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        100
      ],
      "notes": "This stays mocked until a later phase adds an optional HubSpot adapter.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$env.DEMO_MODE || 'true'}}",
              "rightValue": "false",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-persistence-mode",
      "name": "Is Persistence Mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const mismatches = items.filter((item) => {\n  const row = item.json;\n  return row.billingStatus !== row.crmStatus || row.billingMrr !== row.crmMrr || row.billingTier !== row.crmTier;\n});\n\nreturn mismatches.length ? mismatches : [{ json: { noMismatch: true, message: 'No discrepancies detected in the current mock snapshot.' } }];"
      },
      "id": "compare-billing-and-crm",
      "name": "Compare Billing And CRM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        120
      ],
      "notes": "The compare step stays lightweight on purpose. The dashboard remains the primary surface for reviewing discrepancy impact.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$json.noMismatch || false}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "no-mismatches-found",
      "name": "No Mismatches Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        340,
        120
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select 'replace with discrepancy upsert sql' as note;"
      },
      "id": "write-discrepancies-optional",
      "name": "Write Discrepancies (Optional)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        620,
        20
      ],
      "notes": "Template-only write step. Do not enable until you intentionally decide to let n8n write discrepancy rows instead of keeping that concern in the app.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { message: 'No mismatches detected in this run.' } }];"
      },
      "id": "no-mismatch-summary",
      "name": "No Mismatch Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        220
      ]
    }
  ],
