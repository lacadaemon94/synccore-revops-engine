{
  "name": "00 - SyncCore Event Intake Router",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "Demo-first intake router. Use the webhook when testing from an external sender, or Manual Trigger for a local walkthrough. Every branch posts the raw billing payload to the Next.js ingest route before any downstream workflow routing.",
        "height": 240,
        "width": 360,
        "color": 5
      },
      "id": "sticky-intake-overview",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -860,
        -160
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -820,
        120
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "synccore/billing-event",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "billing-webhook-trigger",
      "name": "Billing Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -820,
        340
      ],
      "notes": "Use this endpoint for Stripe-like demo payloads. The path is intentionally stable for local orchestration docs.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const payload = {\n  id: 'evt_demo_subscription_updated_001',\n  type: 'customer.subscription.updated',\n  livemode: false,\n  created: 1780502400,\n  data: {\n    object: {\n      id: 'sub_demo_scale_001',\n      customer: 'cus_norte_cloud',\n      currency: 'usd',\n      status: 'active',\n      metadata: {\n        account_domain: 'norte.cloud',\n        crm_company_id: 'crm_norte_cloud',\n        usage_density: '56'\n      },\n      items: {\n        data: [\n          {\n            price: {\n              unit_amount: 35000\n            }\n          }\n        ]\n      }\n    }\n  }\n};\n\nreturn [{ json: payload }];"
      },
      "id": "load-sample-payload",
      "name": "Load Sample Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -580,
        120
      ],
      "notes": "Swap this sample body for one of the JSON files in n8n/payloads when walking through the suite manually.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const incoming = $json.body ?? $json;\nconst eventType = incoming.type ?? 'unknown';\nconst routeHint = eventType === 'invoice.payment_failed'\n  ? 'failed_payment'\n  : eventType.startsWith('customer.subscription.')\n    ? 'subscription_lifecycle'\n    : 'generic_reconciliation';\n\nreturn [{\n  json: {\n    body: incoming,\n    eventType,\n    providerEventId: incoming.id ?? 'missing_provider_event_id',\n    routeHint,\n    demoMode: $env.DEMO_MODE ?? 'true'\n  }\n}];"
      },
      "id": "normalize-intake-envelope",
      "name": "Normalize Intake Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        220
      ],
      "notes": "Keeps the raw Stripe-like payload intact while adding a route hint for later workflow fan-out.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$json.eventType}}",
              "rightValue": "invoice.payment_failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-failed-payment",
      "name": "Is Failed Payment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -60,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$json.eventType}}",
              "rightValue": "customer.subscription.",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-subscription-event",
      "name": "Is Subscription Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        200,
        360
      ]
    },
    {
