        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.body)}}",
        "options": {}
      },
      "id": "post-failed-payment-to-dashboard",
      "name": "POST Failed Payment To Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        80
      ],
      "notes": "Posts the raw failed-payment payload into the dashboard, which owns validation, event logging, churn classification, and DLQ creation.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SYNC_CORE_INGEST_URL || 'http://host.docker.internal:3000/api/events/ingest'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.body)}}",
        "options": {}
      },
      "id": "post-subscription-event-to-dashboard",
      "name": "POST Subscription Event To Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        280
      ],
      "notes": "Phase 4D still uses the Next.js ingestion route as the system-of-entry before any direct workflow-side writes.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SYNC_CORE_INGEST_URL || 'http://host.docker.internal:3000/api/events/ingest'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.body)}}",
        "options": {}
      },
      "id": "post-generic-event-to-dashboard",
      "name": "POST Generic Event To Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        520
      ],
      "notes": "Use this branch for invoice.paid and any event that should land in the log before reconciliation or downstream review.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    route: 'failed_payment_churn_defuser',\n    message: 'Dashboard ingest completed. Next workflow should inspect churnDefuser, notification, and DLQ fields in the HTTP response.',\n    ingestResponse: $json\n  }\n}];"
      },
      "id": "queue-failed-payment-workflow",
      "name": "Queue Failed Payment Workflow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        80
      ],
      "notes": "Template hand-off point for workflow 02. If you later verify Execute Workflow imports locally, this is the safest swap point.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    route: 'subscription_lifecycle_sync',\n    message: 'Dashboard ingest completed. Continue with lifecycle sync, mock CRM review, or reconciliation logic.',\n    ingestResponse: $json\n  }\n}];"
      },
      "id": "queue-subscription-lifecycle-workflow",
      "name": "Queue Subscription Lifecycle Workflow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    route: 'generic_reconciliation',\n    message: 'Event is logged. Review whether a reconciliation or reporting workflow should pick it up next.',\n    ingestResponse: $json\n  }\n}];"
      },
      "id": "queue-generic-review",
      "name": "Queue Generic Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        520
      ]
    },
    {
      "parameters": {
        "content": "Error handling note: keep workflows inactive until local URLs are confirmed. The dashboard route already returns structured JSON for invalid payloads, duplicate events, churn-defuser outcomes, and demo-mode skips.",
